# Local development only. Copy to .env; choose a password and update both values.
POSTGRES_USER=algomentor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=algomentor
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://algomentor:change-me-local-only@127.0.0.1:55432/algomentor
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
# Optional: integration tests create and drop a unique schema in this database.
# Use a separate, disposable test database, never a production database.
# TEST_DATABASE_URL=postgresql+psycopg://algomentor:change-me-local-only@127.0.0.1:55432/algomentor_test
